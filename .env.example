# LLM Provider settings: Groq (ultra fast) or Anthropic
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
CLAUDE_MODEL=claude-3-5-haiku-20241022

# Embedding model (multilingual: English / Urdu / Roman Urdu)
EMBED_MODEL=intfloat/multilingual-e5-small

# Websites allowed to call the API (comma separated)
ALLOWED_ORIGINS=https://ul.edu.pk,https://www.ul.edu.pk,http://localhost:8000

RATE_LIMIT_PER_MIN=20
TRUST_PROXY=false
TOP_K=6

# Autonomous Website & PDF Watcher Agent
AUTO_SYNC_ENABLED=true
AUTO_SYNC_INTERVAL_MINUTES=60
